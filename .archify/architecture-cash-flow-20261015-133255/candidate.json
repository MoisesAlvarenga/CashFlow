    {
      "dot": "emerald",
      "title": "Serviço Autônomo de Ingestão",
      "items": [
        "API de Transações aceita créditos e débitos via REST",
        "Transactional Outbox garante persistência local ACID antes do envio pela rede",
        "Opera com 100% de disponibilidade mesmo se a Consolidação ou Broker estiverem offline"
      ]
    },
    {
      "dot": "cyan",
      "title": "Mensageria Assíncrona de Eventos",
      "items": [
        "Fachada MassTransit publica TransactionRegisteredEvent",
        "RabbitMQ amortece picos para suportar confortavelmente a carga de 50 req/s",
        "Dead Letter Queue (DLQ) captura mensagens com falha persistente"
      ]
    },
    {
      "dot": "amber",
      "title": "Consolidação & Alto Desempenho",
      "items": [
        "Consumidor idempotente consolida o saldo diário por data do calendário",
        "Cache em memória e consultas indexadas entregam tempo de resposta sub-10ms",
        "Tolera menos de 5% de perda sob condições extremas de pico de carga"
      ]
    }
